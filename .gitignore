cat > .gitignore << 'EOF'
# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Pre-trained models
model/pretrain/

# IDE files
.vscode/
.idea/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db
EOF
echo "experiments/**/*.pth" >> .gitignore
echo "*.pth" >> .gitignore

# 从暂存区移除
git rm --cached experiments/**/*.pth

# 添加并提交 .gitignore
git add .gitignore
git commit -m "Add .gitignore to ignore cache and model files"
git commit -m "Ignore model files"
git push origin gsx_G